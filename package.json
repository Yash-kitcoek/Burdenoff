{
  "name": "document-vault-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "sanity": "bun run lint && bun run typecheck && bun run test",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "gendb": "bun run prisma:generate && bun run migrate:dev -- --name init"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/bun": "^1.2.20",
    "eslint": "^9.34.0",
    "prisma": "^6.15.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
